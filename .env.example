# No passwords are needed: this server only reads CSV files exported from the UDisc app
# (You > menu > Rounds > menu > Export to CSV). Copy to .env and fill in. On Linux/macOS also: chmod 600 .env
# Folder holding your UDisc export(s). Every *.csv in it is read; overlapping exports are de-duplicated.
UDISC_CSV_DIR=C:\path\to\your\udisc\exports
# Your name exactly as it appears in the PlayerName column of the export
UDISC_PLAYER=your_name_in_udisc
# Holes need at least this many rounds before hole_problem_report ranks them
# MIN_HOLE_ROUNDS=3
